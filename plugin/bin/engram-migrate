#!/usr/bin/env bash
# Migration CLI launcher. Unlike hooks, a CLI isn't handed the plugin data dir by the host,
# so this derives it: from the host env when set, else from the installed
# cache/<marketplace>/<plugin>/<version> layout (matching the host's
# data/<plugin>-<marketplace> convention). A dev checkout gets a fixed fallback —
# ensure_deps builds the venv there idempotently. core.migrate reads it back from
# CLAUDE_PLUGIN_DATA.
set -euo pipefail
SELF="$(cd "$(dirname "$0")" && pwd -P)"
ROOT="$(dirname "$SELF")"
if [ -z "${CLAUDE_PLUGIN_DATA:-}" ]; then
  plug_dir="$(dirname "$ROOT")"
  market_dir="$(dirname "$plug_dir")"
  cache_dir="$(dirname "$market_dir")"
  if [ "$(basename "$cache_dir")" = "cache" ]; then
    CLAUDE_PLUGIN_DATA="$(dirname "$cache_dir")/data/$(basename "$plug_dir")-$(basename "$market_dir")"
  else
    CLAUDE_PLUGIN_DATA="$HOME/.engram/plugin-data"
  fi
  export CLAUDE_PLUGIN_DATA
fi
exec bash "$ROOT/runtime/with-venv.sh" "$CLAUDE_PLUGIN_DATA" -m core.migrate "$@"
